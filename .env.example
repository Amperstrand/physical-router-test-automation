# ── Router connection ──────────────────────────────────────────────
TOLLGATE_BACKEND=go
TOLLGATE_SSH_HOST=
TOLLGATE_SSH_USER=root
TOLLGATE_SSH_KEY= <redacted>
TOLLGATE_SSH_PASSWORD=
TOLLGATE_LUCI_URL=http://<ip>:8080
TOLLGATE_LUCI_USER=root
TOLLGATE_LUCI_PASSWORD=

# ── Router inventory (multi-router labs) ──────────────────────────
TOLLGATE_ROUTER_ID=
TOLLGATE_ROUTER_INVENTORY=config/routers.json
TOLLGATE_ROUTER_MODEL=
TOLLGATE_ROUTER_ARCH=aarch64_cortex-a53

# ── WiFi / network ────────────────────────────────────────────────
TOLLGATE_SSID=TollGate
TOLLGATE_SSID_PREFIX=TollGate-
TOLLGATE_WIFI_INTERFACE=
TOLLGATE_UPSTREAM_SSID=
TOLLGATE_UPSTREAM_WIFI_PASSWORD=
TOLLGATE_DOMAIN=
TOLLGATE_ENABLE_WIFI_CLIENT_TESTS=false

# ── Phone testing ─────────────────────────────────────────────────
PHONE_SERIAL=

# ── Virtual lab ──────────────────────────────────────────────────────
TOLLGATE_VIRTUAL_LAB=true
TOLLGATE_CLIENT_TYPE=container
TOLLGATE_CLIENT_IP=<ip>
TOLLGATE_CONTAINER_HOST=
TOLLGATE_SSH_JUMP_HOST=
TOLLGATE_V2_MINT_URL=https://testnut.cashu.space
TOLLGATE_RECORD_ALL=

# ── Payment / protocol ────────────────────────────────────────────
TOLLGATE_PAYMENT_STEPS=100
TOLLGATE_CONNECTIVITY_HOST=<ip>
TOLLGATE_TEST_MINT_URL=https://testnut.cashu.exchange
TOLLGATE_LOCAL_MINT_URL=http://<ip>:8085
TOLLGATE_LOCAL_502_MINT_URL=http://<ip>:8086

# ── Data allotment ────────────────────────────────────────────────
TOLLGATE_ENABLE_DATA_ALLOTMENT_TESTS=false
TOLLGATE_DATA_TEST_URL=https://nbg1-speed.hetzner.com/100MB.bin
TOLLGATE_DATA_TEST_TIMEOUT=300

# ── Firmware / flashing ──────────────────────────────────────────
TOLLGATE_PACKAGE_PATH=
TOLLGATE_ETHERNET_INTERFACES=
TOLLGATE_FIRMWARE_IMAGE=
TOLLGATE_ENABLE_SYSUPGRADE_TESTS=false
TOLLGATE_ENABLE_SYSUPGRADE_FLASHING=false
TOLLGATE_SYSUPGRADE_WIPE_CONFIG=false

# ── Playwright ────────────────────────────────────────────────────
TOLLGATE_VIEWPORT=desktop

# ── Profile-based testing ──────────────────────────────────────────
TOLLGATE_LAB_TYPE=
TOLLGATE_PROFILE=

# ── Report publishing ─────────────────────────────────────────────
TOLLGATE_PUBLISH=false
TOLLGATE_BRANCH=
TOLLGATE_PR=
TOLLGATE_GH_PAGES_KEEP=10

# ── Blossom publishing (replaces GitHub token on VM) ─────────────
# The result publisher uploads artifacts to Blossom and announces them
# via Nostr NIP-94 + kind 30078 summary events. The Nostr reader page
# (docs/) fetches these events from relays and renders screenshots from
# Blossom URLs. This removes the need for a GitHub token on the VM.
NSEC_FILE=~/.config/prta/nsec
# Comma-separated for multiple servers (e.g. https://blossom.psbt.me,https://other.blossom.server)
BLOSSOM_SERVERS=https://blossom.psbt.me
# Comma-separated for multiple relays (e.g. wss://relay.cashu.email,wss://relay.damus.io)
NOSTR_RELAYS=wss://relay.cashu.email
# GITHUB_TOKEN no longer needed on the VM for publishing

# ── FIPS exit node smoke tests (tests/api/test_fips_exit_node.py) ──
# The exit node is a WireGuard-based VPS that routes FIPS mesh traffic to the
# internet via an nftables 'fips-exit' MASQUERADE table. The smoke tests SSH to
# it directly (no router/hardware lock) and skip gracefully when the node is
# unreachable or not yet deployed there. Run via `make fips-exit-smoke`.
# None of these are required — sensible defaults are applied.
FIPS_EXIT_HOST=<ip>
FIPS_EXIT_SSH_USER=root
FIPS_EXIT_SSH_KEY=
FIPS_EXIT_SSH_PORT=22
FIPS_EXIT_SSH_PASSWORD=
# Hex Nostr pubkey (npub) of the exit node — required to attribute kind 30078
# route-advertisement events. Without it the advert test skips.
FIPS_EXIT_NPUB=
# Comma-separated wss:// relays to query for the advert (defaults to the
# project coordination relays if left blank).
FIPS_EXIT_RELAYS=
