#!/usr/bin/env bash
# TEST DOUBLE for uci (OpenWrt's config CLI).  It implements the operations the
# offline installer uses — get / add / add_list / set / commit / show — over one file
# per package under <root>/etc/config, with the flattened key names uci uses
# (@nodogsplash[0].trustedmac).  List members are stored |-separated and printed the
# way real uci prints them: pkg.section.key='item one' 'item two'.
#
# SECTION SEMANTICS ARE FAITHFUL, NOT LENIENT.  Real uci refuses
# `add_list pkg.@type[0].key=…` / `set pkg.@type[0].key=…` with `uci: Entry not found`
# when the SECTION does not exist yet — which is exactly what bit a freshly flashed
# router (no /etc/config/nodogsplash until nodogsplash is installed).  An anonymous
# section is modelled as a sentinel row (`@nodogsplash[0]` -> `nodogsplash`) that
# `uci add <pkg> <type>` creates; a write into a missing section fails, like the real
# tool.  Without this the double would silently create sections and the fresh-box
# defect could never be reproduced here (see T21).
#
# TGOFFLINE_HARNESS_UCI_IGNORE=1 makes `commit` DISCARD the staged writes, which models
# "the keepalive seed applied but the trust did not take" — the negative control for the
# lockout gate.
set -uo pipefail

ROOT="${TGOFFLINE_HARNESS_ROOT:?the harness must export TGOFFLINE_HARNESS_ROOT}"
CONF="$ROOT/etc/config"
mkdir -p "$CONF"

quiet=0
while [ "${1:-}" = "-q" ] || [ "${1:-}" = "-c" ] || [ "${1:-}" = "-d" ]; do
    case "$1" in
        -q) quiet=1; shift ;;
        -c|-d) shift 2 ;;
    esac
done
op="${1:-}"; shift || true
arg="${1:-}"

pkg_of() { printf '%s' "$1" | cut -d. -f1; }
key_of() { printf '%s' "$1" | cut -d. -f2-; }
# the section part of a pkg.section.key path (@nodogsplash[0] out of the flattened key)
section_of() { printf '%s' "$(key_of "$1")" | sed 's/\.[^.]*$//'; }
committed() { printf '%s/%s' "$CONF" "$(pkg_of "$1")"; }
staged() { printf '%s/.%s.staged' "$CONF" "$(pkg_of "$1")"; }

lookup() { # lookup <pkg.key> -> raw value (staged wins), rc=1 when absent
    local sf cf k v f value=""
    sf="$(staged "$1")"; cf="$(committed "$1")"
    k="$(key_of "$1")"
    for f in "$sf" "$cf"; do
        [ -f "$f" ] || continue
        v="$(awk -F'	' -v k="$k" '$1 == k { print $2 }' "$f" | head -1)"
        [ -n "$v" ] && value="$v"
    done
    [ -n "$value" ] || return 1
    printf '%s' "$value"
}

require_section() { # require_section <pkg.section.key>  -> 0 when its section exists
    # a REAL uci write into a section that does not exist fails with `Entry not found`;
    # the section sentinel is looked up exactly like any other key.
    lookup "$(pkg_of "$1").$(section_of "$1")" >/dev/null 2>&1
}

case "$op" in
    get)
        if value="$(lookup "$arg")"; then
            printf '%s\n' "$(printf '%s' "$value" | tr '|' ' ')"
            exit 0
        fi
        [ "$quiet" = 1 ] || echo "uci: Entry not found" >&2
        exit 1
        ;;
    add)
        # add <package> <type> [<name>] — creates an anonymous section.  After `shift`
        # above, $1 is the package and $2 the type.
        pkg="${1:-}"; type="${2:-}"
        if [ -z "$pkg" ] || [ -z "$type" ]; then
            echo "uci(double): add needs <package> <type>" >&2
            exit 2
        fi
        staged_file="$CONF/.$pkg.staged"
        [ -f "$staged_file" ] || { [ -f "$CONF/$pkg" ] && cp "$CONF/$pkg" "$staged_file" || : > "$staged_file"; }
        n="$(awk -F'	' -v t="$type" '$1 ~ ("^@" t "\\[")' "$staged_file" 2>/dev/null | wc -l | tr -d ' ')"
        printf '@%s[%s]	%s\n' "$type" "$n" "$type" >> "$staged_file"
        printf '@%s[%s]\n' "$type" "$n"   # what real uci prints back (its anonymous name)
        exit 0
        ;;
    add_list)
        key="${arg%%=*}"; value="${arg#*=}"
        if ! require_section "$key"; then
            echo "uci: Entry not found" >&2
            exit 1
        fi
        staged_file="$(staged "$arg")"; committed_file="$(committed "$arg")"
        [ -f "$staged_file" ] || { [ -f "$committed_file" ] && cp "$committed_file" "$staged_file" || : > "$staged_file"; }
        key_only="$(key_of "$key")"
        cur="$(awk -F'	' -v k="$key_only" '$1 == k { print $2 }' "$staged_file" | head -1)"
        # real uci is a set: adding an existing member is a no-op
        case "|$cur|" in
            *"|$value|"*) ;;
            *) new="$value"; [ -n "$cur" ] && new="$cur|$value"
               awk -F'	' -v k="$key_only" '$1 != k' "$staged_file" > "$staged_file.new"
               printf '%s	%s\n' "$key_only" "$new" >> "$staged_file.new"
               mv "$staged_file.new" "$staged_file" ;;
        esac
        exit 0
        ;;
    set)
        key="${arg%%=*}"; value="${arg#*=}"
        if ! require_section "$key"; then
            echo "uci: Entry not found" >&2
            exit 1
        fi
        staged_file="$(staged "$arg")"; committed_file="$(committed "$arg")"
        [ -f "$staged_file" ] || { [ -f "$committed_file" ] && cp "$committed_file" "$staged_file" || : > "$staged_file"; }
        key_only="$(key_of "$key")"
        awk -F'	' -v k="$key_only" '$1 != k' "$staged_file" > "$staged_file.new"
        printf '%s	%s\n' "$key_only" "$value" >> "$staged_file.new"
        mv "$staged_file.new" "$staged_file"
        exit 0
        ;;
    commit)
        n="${arg:-}"
        if [ -n "$n" ]; then
            staged_file="$(staged "$n")"; committed_file="$(committed "$n")"
            if [ -f "$staged_file" ]; then
                if [ "${TGOFFLINE_HARNESS_UCI_IGNORE:-0}" = 1 ]; then
                    rm -f "$staged_file"        # the writes did not take effect
                else
                    mv "$staged_file" "$committed_file"
                fi
            fi
        fi
        exit 0
        ;;
    show)
        n="${arg:-}"
        for f in "$(committed "$n.1")" "$(staged "$n.1")"; do
            [ -f "$f" ] || continue
            while IFS="$(printf '\t')" read -r key value; do
                [ -n "$key" ] || continue
                items=""
                old_ifs="$IFS"; IFS='|'
                for item in $value; do items="$items '$item'"; done
                IFS="$old_ifs"
                printf '%s.%s=%s\n' "$(pkg_of "$n")" "$key" "$items"
            done < "$f"
        done
        exit 0
        ;;
    *)
        echo "uci(double): unsupported command '${op}'" >&2
        exit 2
        ;;
esac
